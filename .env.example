# Optional: Google Gemini API credentials for external API mode
# Free tier available via Google AI Studio (https://aistudio.google.com/apikey)
# ₹0 cost — no billing or credit card required for standard free tier.
# Copy this file to .env and fill in your real key.
# NEVER commit the real .env file to version control.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
