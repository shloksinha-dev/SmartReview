# Secrets for Streamlit Community Cloud deployment.
# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit the real secrets.toml to version control.

# [optional] Google Gemini API key for external API mode (free tier at https://aistudio.google.com/apikey)
# GEMINI_API_KEY = "your-gemini-api-key-here"
# GEMINI_MODEL = "gemini-3.8-flash"
